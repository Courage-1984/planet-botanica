{%- comment -%}
  Rendered via /search/suggest?section_id=predictive-search — not placed in templates.
{%- endcomment -%}

{%- if predictive_search.performed -%}
  {%- liquid
    assign resources = predictive_search.resources
    assign total = resources.products.size | plus: resources.collections.size | plus: resources.articles.size | plus: resources.pages.size
    assign encoded_terms = predictive_search.terms | url_encode
  -%}
  <div class="predictive-search__inner" data-predictive-count="{{ total }}">
    {%- if resources.products.size > 0 -%}
      <div class="predictive-search__group">
        <h2 class="eyebrow">{{ 'general.search.products' | t }}</h2>
        <ul class="predictive-search__list" role="list">
          {%- for product in resources.products -%}
            <li>
              <a href="{{ product.url }}" class="predictive-item">
                <span class="predictive-item__media media" style="--ratio: 1;">
                  {%- if product.featured_media -%}
                    {{ product.featured_media.preview_image | image_url: width: 120 | image_tag: loading: 'lazy', alt: '', width: 60, height: 60 }}
                  {%- endif -%}
                </span>
                <span class="predictive-item__text">
                  <span class="predictive-item__title">{{ product.title | escape }}</span>
                  {%- assign origin = product.metafields.custom.origin_location.value -%}
                  {%- if origin != blank or product.type != blank -%}
                    <span class="predictive-item__botanical">
                      {{- product.type -}}
                      {%- if product.type != blank and origin != blank %} · {% endif -%}
                      {{- origin -}}
                    </span>
                  {%- endif -%}
                </span>
                <span class="predictive-item__price">{{ product.price | money }}</span>
              </a>
            </li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}

    {%- if resources.collections.size > 0 or resources.articles.size > 0 or resources.pages.size > 0 -%}
      <div class="predictive-search__group">
        <h2 class="eyebrow">{{ 'general.search.suggestions' | t }}</h2>
        <ul class="predictive-search__list predictive-search__list--links" role="list">
          {%- for collection in resources.collections -%}
            <li><a href="{{ collection.url }}" class="predictive-link">{% render 'icon', icon: 'leaf' %}{{ collection.title | escape }}</a></li>
          {%- endfor -%}
          {%- for article in resources.articles -%}
            <li><a href="{{ article.url }}" class="predictive-link">{% render 'icon', icon: 'info' %}{{ article.title | escape }}</a></li>
          {%- endfor -%}
          {%- for page in resources.pages -%}
            <li><a href="{{ page.url }}" class="predictive-link">{% render 'icon', icon: 'chevron-right' %}{{ page.title | escape }}</a></li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}

    {%- if total == 0 -%}
      <p class="predictive-search__empty">{{ 'general.search.no_results' | t: terms: predictive_search.terms }}</p>
    {%- endif -%}

    <a href="{{ routes.search_url }}?q={{ encoded_terms }}&options%5Bprefix%5D=last" class="predictive-search__all link-arrow">
      {{- 'general.search.view_all' | t: terms: predictive_search.terms -}}
      {%- render 'icon', icon: 'arrow-right' -%}
    </a>
  </div>
{%- endif -%}
