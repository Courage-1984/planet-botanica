<div class="password">
  <div class="password__inner">
    <div class="password__brand">
      {%- if settings.logo_inverse != blank or settings.logo != blank -%}
        {%- assign password_logo = settings.logo_inverse | default: settings.logo -%}
        {{ password_logo | image_url: width: 500 | image_tag: loading: 'eager', widths: '250, 500', sizes: '250px', alt: shop.name, class: 'password__logo' }}
      {%- else -%}
        <p class="header__logo-text">{{ shop.name }}</p>
      {%- endif -%}
    </div>

    {%- if section.settings.heading != blank -%}
      <h1 class="h0 password__heading">{{ section.settings.heading }}</h1>
    {%- endif -%}
    {%- if shop.password_message != blank -%}
      <p class="password__message">{{ shop.password_message }}</p>
    {%- elsif section.settings.text != blank -%}
      <div class="rte password__message">{{ section.settings.text }}</div>
    {%- endif -%}

    {%- form 'customer', class: 'newsletter__form password__signup' -%}
      <input type="hidden" name="contact[tags]" value="prospect,password page">
      {%- if form.posted_successfully? -%}
        <p class="form-message form-message--success" role="status">{{ 'sections.newsletter.launch_success' | t }}</p>
      {%- else -%}
        <div class="newsletter__field">
          <label for="PasswordNewsletter" class="visually-hidden">{{ 'sections.newsletter.email' | t }}</label>
          <input id="PasswordNewsletter" type="email" name="contact[email]" class="field__input" placeholder="{{ 'sections.newsletter.email' | t }}" autocomplete="email" required>
          <button type="submit" class="btn btn--primary">{{ 'sections.newsletter.notify' | t }}</button>
        </div>
        {%- if form.errors -%}
          <p class="form-message form-message--error">{{ form.errors | default_errors }}</p>
        {%- endif -%}
      {%- endif -%}
    {%- endform -%}

    <details class="password__login">
      <summary>{{ 'templates.password.owner' | t }}</summary>
      {%- form 'storefront_password', class: 'password__form' -%}
        {%- if form.errors -%}
          <p class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</p>
        {%- endif -%}
        <div class="newsletter__field">
          <label for="StorefrontPassword" class="visually-hidden">{{ 'templates.password.password' | t }}</label>
          <input id="StorefrontPassword" type="password" name="password" class="field__input" placeholder="{{ 'templates.password.password' | t }}" autocomplete="current-password" required>
          <button type="submit" class="btn btn--secondary">{{ 'templates.password.enter' | t }}</button>
        </div>
      {%- endform -%}
      <p class="password__admin">{{ 'templates.password.admin_link_html' | t }}</p>
    </details>
  </div>
</div>

{% schema %}
{
  "name": "Password page",
  "class": "section-main-password",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Something's growing here"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "info": "Shown when no password message is set in Preferences.",
      "default": "<p>Our nursery shop opens soon. Leave your email and be first in line for opening-day plants.</p>"
    }
  ]
}
{% endschema %}
