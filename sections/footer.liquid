{%- liquid
  assign has_business_details = false
  if settings.legal_name != blank or settings.registration_number != blank or settings.vat_number != blank or settings.physical_address != blank
    assign has_business_details = true
  endif
-%}

<footer class="footer scheme-{{ section.settings.color_scheme }}">
  <div class="container">
    {%- if section.blocks.size > 0 -%}
      <div class="footer__grid">
        {%- for block in section.blocks -%}
          <div class="footer__block footer__block--{{ block.type }}" {{ block.shopify_attributes }}>
            {%- case block.type -%}
              {%- when 'brand' -%}
                <a href="{{ routes.root_url }}" class="footer__logo">
                  {%- assign footer_logo = settings.logo_inverse | default: settings.logo -%}
                  {%- if footer_logo != blank -%}
                    {{ footer_logo | image_url: width: 400 | image_tag: loading: 'lazy', widths: '150, 200, 300, 400', sizes: '200px', alt: shop.name }}
                  {%- else -%}
                    <span class="header__logo-text">{{ shop.name }}</span>
                  {%- endif -%}
                </a>
                {%- if block.settings.text != blank -%}
                  <div class="rte footer__text">{{ block.settings.text }}</div>
                {%- endif -%}
                {%- if block.settings.show_social -%}
                  {% render 'social-icons' %}
                {%- endif -%}

              {%- when 'menu' -%}
                {%- if block.settings.heading != blank -%}
                  <h2 class="footer__heading">{{ block.settings.heading }}</h2>
                {%- endif -%}
                <ul class="footer__links" role="list">
                  {%- for link in block.settings.menu.links -%}
                    <li><a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a></li>
                  {%- endfor -%}
                </ul>

              {%- when 'contact' -%}
                {%- if block.settings.heading != blank -%}
                  <h2 class="footer__heading">{{ block.settings.heading }}</h2>
                {%- endif -%}
                <ul class="footer__contact" role="list">
                  {%- if settings.contact_email != blank -%}
                    <li>{% render 'icon', icon: 'mail' %}<a href="mailto:{{ settings.contact_email }}">{{ settings.contact_email }}</a></li>
                  {%- endif -%}
                  {%- if settings.contact_phone != blank -%}
                    <li>{% render 'icon', icon: 'phone' %}<a href="tel:{{ settings.contact_phone | remove: ' ' }}">{{ settings.contact_phone }}</a></li>
                  {%- endif -%}
                  {%- if settings.whatsapp_number != blank -%}
                    <li>{% render 'icon', icon: 'whatsapp' %}<a href="https://wa.me/{{ settings.whatsapp_number | remove: '+' | remove: ' ' }}" target="_blank" rel="noopener">{{ 'general.whatsapp' | t }}</a></li>
                  {%- endif -%}
                  {%- if block.settings.hours != blank -%}
                    <li>{% render 'icon', icon: 'clock' %}<span>{{ block.settings.hours }}</span></li>
                  {%- endif -%}
                </ul>

              {%- when 'text' -%}
                {%- if block.settings.heading != blank -%}
                  <h2 class="footer__heading">{{ block.settings.heading }}</h2>
                {%- endif -%}
                <div class="rte footer__text">{{ block.settings.text }}</div>
            {%- endcase -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="footer__bottom">
      <div class="footer__legal">
        <p>&copy; {{ 'now' | date: '%Y' }} {{ settings.legal_name | default: shop.name }}. {{ 'sections.footer.rights' | t }}</p>
        {%- if has_business_details -%}
          <p class="footer__business">
            {%- if settings.registration_number != blank -%}
              <span>{{ 'sections.footer.registration' | t }} {{ settings.registration_number }}</span>
            {%- endif -%}
            {%- if settings.vat_number != blank -%}
              <span>{{ 'sections.footer.vat' | t }} {{ settings.vat_number }}</span>
            {%- endif -%}
            {%- if settings.physical_address != blank -%}
              <span>{{ settings.physical_address | newline_to_br | replace: '<br />', ', ' | strip_newlines }}</span>
            {%- endif -%}
          </p>
        {%- endif -%}
        {%- if section.settings.show_policies -%}
          <ul class="footer__policies" role="list">
            {%- for policy in shop.policies -%}
              {%- if policy != blank -%}
                <li><a href="{{ policy.url }}">{{ policy.title | escape }}</a></li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
        <ul class="footer__payments" role="list" aria-label="{{ 'sections.footer.payment_methods' | t }}">
          {%- for type in shop.enabled_payment_types -%}
            <li>{{ type | payment_type_svg_tag: class: 'payment-icon' }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "section-footer",
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour scheme",
      "options": [
        { "value": "light", "label": "Light" },
        { "value": "surface", "label": "Light surface" },
        { "value": "dark", "label": "Dark" },
        { "value": "accent", "label": "Accent" }
      ],
      "default": "dark"
    },
    {
      "type": "checkbox",
      "id": "show_policies",
      "label": "Show policy links",
      "info": "Add policies in Settings → Policies.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment icons",
      "default": true
    },
    {
      "type": "paragraph",
      "content": "Company registration, VAT number and address come from Theme settings → Business details."
    }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand",
      "limit": 1,
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Nursery-grown carnivorous plants, raised with rainwater and shipped with care across South Africa.</p>"
        },
        {
          "type": "checkbox",
          "id": "show_social",
          "label": "Show social icons",
          "default": true
        }
      ]
    },
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Shop"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "default": "footer"
        }
      ]
    },
    {
      "type": "contact",
      "name": "Contact",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Get in touch"
        },
        {
          "type": "text",
          "id": "hours",
          "label": "Hours",
          "default": "Mon–Fri, 08:00–16:00"
        },
        {
          "type": "paragraph",
          "content": "Email, phone and WhatsApp come from Theme settings."
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Heading"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Share store details, promotions, or brand content with your customers.</p>"
        }
      ]
    }
  ],
  "max_blocks": 6
}
{% endschema %}
