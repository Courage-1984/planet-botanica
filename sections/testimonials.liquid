<div
  class="section scheme-{{ section.settings.color_scheme }}"
  style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="container">
    {%- if section.settings.heading != blank or section.settings.eyebrow != blank -%}
      <div class="section-header">
        <div>
          {%- if section.settings.eyebrow != blank -%}
            <p class="eyebrow">{{ section.settings.eyebrow }}</p>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="h2">{{ section.settings.heading }}</h2>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

    <ul class="grid grid--scroll quotes" role="list" style="--cols: {{ section.blocks.size | at_most: 3 | at_least: 1 }};">
      {%- for block in section.blocks -%}
        <li class="quote" {{ block.shopify_attributes }}>
          {%- if block.settings.rating > 0 -%}
            <p class="quote__rating" aria-label="{{ 'sections.testimonials.rating' | t: rating: block.settings.rating }}">
              {%- for i in (1..5) -%}
                <span aria-hidden="true"{% if i > block.settings.rating %} class="is-empty"{% endif %}>★</span>
              {%- endfor -%}
            </p>
          {%- endif -%}
          <blockquote class="quote__text">{{ block.settings.quote }}</blockquote>
          <p class="quote__author">
            <strong>{{ block.settings.author }}</strong>
            {%- if block.settings.location != blank %} · {{ block.settings.location }}{% endif -%}
          </p>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Testimonials",
  "tag": "section",
  "class": "section-testimonials",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "From our growers"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Happy plants, happy people"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour scheme",
      "options": [
        { "value": "light", "label": "Light" },
        { "value": "surface", "label": "Light surface" },
        { "value": "dark", "label": "Dark" },
        { "value": "accent", "label": "Accent" }
      ],
      "default": "light"
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "quote",
      "name": "Testimonial",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "Add a customer review here. Only publish real reviews, with the customer's permission."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Name",
          "default": "Customer name"
        },
        {
          "type": "text",
          "id": "location",
          "label": "Location",
          "default": "City"
        },
        {
          "type": "range",
          "id": "rating",
          "min": 0,
          "max": 5,
          "step": 1,
          "label": "Star rating",
          "info": "0 hides the stars.",
          "default": 5
        }
      ]
    }
  ],
  "max_blocks": 9,
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        { "type": "quote" },
        { "type": "quote" },
        { "type": "quote" }
      ]
    }
  ]
}
{% endschema %}
