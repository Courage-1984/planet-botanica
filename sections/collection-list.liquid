<div
  class="section scheme-{{ section.settings.color_scheme }}"
  style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="container">
    {%- if section.settings.heading != blank or section.settings.eyebrow != blank -%}
      <div class="section-header">
        <div>
          {%- if section.settings.eyebrow != blank -%}
            <p class="eyebrow">{{ section.settings.eyebrow }}</p>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="h2">{{ section.settings.heading }}</h2>
          {%- endif -%}
        </div>
        {%- if section.settings.show_view_all -%}
          <a href="{{ routes.collections_url }}" class="link-arrow">
            {{- 'sections.collection_list.view_all' | t -}}
            {%- render 'icon', icon: 'arrow-right' -%}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}

    <ul class="grid grid--tiles" role="list" style="--cols: {{ section.settings.columns }};">
      {%- for block in section.blocks -%}
        {%- liquid
          assign collection = block.settings.collection
          assign tile_image = block.settings.image | default: collection.featured_image
          assign tile_title = block.settings.title | default: collection.title
          if tile_title == blank
            assign tile_title = 'sections.collection_list.placeholder' | t
          endif
          assign placeholder_index = forloop.index0 | modulo: 6 | plus: 1
          assign placeholder_name = 'collection-' | append: placeholder_index
        -%}
        <li class="collection-tile" {{ block.shopify_attributes }}>
          <div class="collection-tile__media media" style="--ratio: 0.8;">
            {%- if tile_image != blank -%}
              {{
                tile_image
                | image_url: width: 900
                | image_tag:
                  loading: 'lazy',
                  widths: '300, 450, 600, 900',
                  sizes: '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 50vw',
                  alt: tile_title
              }}
            {%- else -%}
              {{ placeholder_name | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>
          <div class="collection-tile__info">
            {%- if block.settings.caption != blank -%}
              <p class="collection-tile__caption">{{ block.settings.caption }}</p>
            {%- endif -%}
            <h3 class="collection-tile__title">
              <a href="{{ collection.url | default: routes.collections_url }}" class="collection-tile__link">
                {{- tile_title | escape -}}
              </a>
            </h3>
            {%- if section.settings.show_count and collection != blank -%}
              <p class="collection-tile__count">{{ 'sections.collection_list.count' | t: count: collection.products_count }}</p>
            {%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Collection tiles",
  "tag": "section",
  "class": "section-collection-list",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Shop by genus"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Meet the carnivores"
    },
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 6,
      "step": 1,
      "label": "Columns on desktop",
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_count",
      "label": "Show product count",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show 'view all' link",
      "default": true
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour scheme",
      "options": [
        { "value": "light", "label": "Light" },
        { "value": "surface", "label": "Light surface" },
        { "value": "dark", "label": "Dark" },
        { "value": "accent", "label": "Accent" }
      ],
      "default": "light"
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title override"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption",
          "info": "e.g. the genus — Dionaea"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image override"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Collection tiles",
      "blocks": [
        { "type": "collection", "settings": { "caption": "Dionaea" } },
        { "type": "collection", "settings": { "caption": "Drosera" } },
        { "type": "collection", "settings": { "caption": "Sarracenia" } },
        { "type": "collection", "settings": { "caption": "Nepenthes" } }
      ]
    }
  ]
}
{% endschema %}
