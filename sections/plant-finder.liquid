{%- comment -%}
  "Find your carnivore" quiz. Each question block maps to a plant.* metafield
  filter; answers become storefront filter params on the target collection, e.g.
  /collections/live-plants?filter.p.m.plant.difficulty=Beginner
  Requires those metafields to be enabled as filters in Search & Discovery.
  Option values: use | for several values (Beginner|Intermediate); leave blank for "any".
{%- endcomment -%}

{%- liquid
  assign target = section.settings.collection
  assign action_url = target.url | default: collection.url | default: routes.all_products_collection_url
-%}

<div
  id="finder"
  class="section scheme-{{ section.settings.color_scheme }}"
  style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="container">
    <plant-finder class="finder">
      <div class="finder__intro">
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="h2">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="rte">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>

      {%- if section.blocks.size > 0 -%}
        <form class="finder__form" action="{{ action_url }}" method="get" novalidate>
          <ol class="finder__progress" role="list" aria-hidden="true">
            {%- for block in section.blocks -%}
              <li{% if forloop.first %} class="is-active"{% endif %}></li>
            {%- endfor -%}
          </ol>

          {%- for block in section.blocks -%}
            {%- assign param = 'filter.p.m.plant.' | append: block.settings.filter -%}
            <fieldset class="finder__step{% if forloop.first %} is-active{% endif %}" data-step="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
              <legend class="finder__question">
                <span class="finder__count">{{ forloop.index }} / {{ forloop.length }}</span>
                {{ block.settings.question }}
              </legend>

              <div class="finder__options">
                {%- for i in (1..4) -%}
                  {%- liquid
                    assign label_key = 'option_' | append: i | append: '_label'
                    assign value_key = 'option_' | append: i | append: '_value'
                    assign icon_key = 'option_' | append: i | append: '_icon'
                    assign label = block.settings[label_key]
                    assign value = block.settings[value_key]
                    assign option_icon = block.settings[icon_key]
                  -%}
                  {%- if label != blank -%}
                    <label class="finder__option">
                      <input type="radio" name="{{ param }}" value="{{ value | escape }}">
                      <span class="finder__card">
                        {%- if option_icon != 'none' -%}
                          {%- render 'icon', icon: option_icon -%}
                        {%- endif -%}
                        <span class="finder__label">{{ label }}</span>
                      </span>
                    </label>
                  {%- endif -%}
                {%- endfor -%}
              </div>

              <p class="finder__error form-error" role="alert" hidden></p>

              <div class="finder__nav">
                {%- unless forloop.first -%}
                  <button type="button" class="btn btn--ghost" data-finder-back>
                    {%- render 'icon', icon: 'chevron-left' -%}
                    {{ 'sections.plant_finder.back' | t }}
                  </button>
                {%- endunless -%}
                {%- if forloop.last -%}
                  <button type="submit" class="btn btn--primary">
                    {%- if section.settings.submit_label != blank -%}
                      {{ section.settings.submit_label | escape }}
                    {%- else -%}
                      {{ 'sections.plant_finder.submit' | t }}
                    {%- endif -%}
                  </button>
                {%- else -%}
                  <button type="button" class="btn btn--primary" data-finder-next>
                    {{ 'sections.plant_finder.next' | t }}
                    {%- render 'icon', icon: 'arrow-right' -%}
                  </button>
                {%- endif -%}
              </div>
            </fieldset>
          {%- endfor -%}
        </form>
      {%- endif -%}
    </plant-finder>
  </div>
</div>

{% schema %}
{
  "name": "Plant finder quiz",
  "tag": "section",
  "class": "section-plant-finder",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
