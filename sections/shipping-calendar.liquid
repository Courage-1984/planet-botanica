{%- comment -%}
  Explains the live-plant dispatch week. Dispatch days come from
  Theme settings → Live plant shipping, so this stays in sync with the product page.
{%- endcomment -%}

{%- assign day_names = 'products.dispatch.weekdays' | t | split: ',' -%}

<div
  class="section scheme-{{ section.settings.color_scheme }}"
  style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="container">
    <div class="shipping">
      <div class="shipping__intro">
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="h2">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="rte">{{ section.settings.text }}</div>
        {%- endif -%}
        {% render 'dispatch-notice', compact: true %}
      </div>

      <div class="shipping__week">
        <ol class="week" role="list" aria-label="{{ 'sections.shipping.week_label' | t }}">
          {%- for i in (1..7) -%}
            {%- liquid
              assign day_index = i | modulo: 7
              assign is_dispatch = false
              case day_index
                when 1
                  assign is_dispatch = settings.dispatch_mon
                when 2
                  assign is_dispatch = settings.dispatch_tue
                when 3
                  assign is_dispatch = settings.dispatch_wed
                when 4
                  assign is_dispatch = settings.dispatch_thu
                when 5
                  assign is_dispatch = settings.dispatch_fri
              endcase

              if settings.dispatch_paused
                assign is_dispatch = false
              endif

              if is_dispatch
                assign status = 'sections.shipping.dispatch' | t
                assign status_class = 'dispatch'
              elsif day_index == 0 or day_index == 6
                assign status = 'sections.shipping.rest' | t
                assign status_class = 'rest'
              else
                assign status = 'sections.shipping.delivery' | t
                assign status_class = 'delivery'
              endif
            -%}
            <li class="week__day week__day--{{ status_class }}">
              <span class="week__name">{{ day_names[day_index] | slice: 0, 3 }}</span>
              <span class="week__status">{{ status }}</span>
            </li>
          {%- endfor -%}
        </ol>
      </div>

      {%- if section.blocks.size > 0 -%}
        <ul class="shipping__facts" role="list">
          {%- for block in section.blocks -%}
            <li class="shipping__fact" {{ block.shopify_attributes }}>
              {%- render 'icon', icon: block.settings.icon -%}
              <div>
                <h3 class="shipping__fact-title">{{ block.settings.heading }}</h3>
                <div class="rte">{{ block.settings.text }}</div>
              </div>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Shipping week",
  "tag": "section",
  "class": "section-shipping-calendar",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Dispatch days, cut-off time and pause message are set in Theme settings → Live plant shipping."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Live plant delivery"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "How we ship living things"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Plants leave the nursery early in the week and reach main centres in 1–3 working days. Regional areas can take a little longer.</p>"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour scheme",
      "options": [
        { "value": "light", "label": "Light" },
        { "value": "surface", "label": "Light surface" },
        { "value": "dark", "label": "Dark" },
        { "value": "accent", "label": "Accent" }
      ],
      "default": "surface"
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "fact",
      "name": "Shipping fact",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "truck", "label": "Delivery" },
            { "value": "thermometer", "label": "Thermometer" },
            { "value": "moon", "label": "Moon" },
            { "value": "map-pin", "label": "Location" },
            { "value": "shield", "label": "Guarantee" },
            { "value": "soil", "label": "Pot" },
            { "value": "calendar", "label": "Calendar" }
          ],
          "default": "truck"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Heading"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Text</p>"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Shipping week",
      "blocks": [
        {
          "type": "fact",
          "settings": {
            "icon": "thermometer",
            "heading": "Heatwave & cold-snap holds",
            "text": "<p>If extreme weather is forecast on your route, we hold your order and let you know — your plant's health comes first.</p>"
          }
        },
        {
          "type": "fact",
          "settings": {
            "icon": "map-pin",
            "heading": "Door or pickup point",
            "text": "<p>Choose courier delivery to your door, or collect from a pickup point or locker near you at checkout.</p>"
          }
        },
        {
          "type": "fact",
          "settings": {
            "icon": "shield",
            "heading": "Arrive-alive promise",
            "text": "<p>If a plant arrives damaged, send us a photo within 48 hours of delivery and we'll replace or refund it.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
