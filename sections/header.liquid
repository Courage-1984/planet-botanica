{%- liquid
  assign menu = section.settings.menu
  assign promo = section.settings.promo_collection
  assign scheme = section.settings.color_scheme
  if settings.logo != blank
    assign logo_height = settings.logo_width | divided_by: settings.logo.aspect_ratio | round
  endif
-%}

<div class="header-wrapper scheme-{{ scheme }}{% if section.settings.sticky %} header-wrapper--sticky{% endif %}">
  <header class="header container">
    {%- comment -%} Mobile menu {%- endcomment -%}
    <details class="menu-drawer" data-menu-drawer>
      <summary class="header__icon menu-drawer__toggle" aria-label="{{ 'general.menu.open' | t }}">
        {%- render 'icon', icon: 'menu', class: 'menu-drawer__open' -%}
        {%- render 'icon', icon: 'close', class: 'menu-drawer__close' -%}
      </summary>
      <div class="menu-drawer__panel scheme-{{ scheme }}">
        <div class="menu-drawer__search">
          {% render 'search-form', id: 'Drawer' %}
        </div>

        <nav aria-label="{{ 'general.menu.label' | t }}">
          <ul class="menu-drawer__list" role="list">
            {%- for link in menu.links -%}
              <li>
                {%- if link.links != blank -%}
                  <details class="menu-drawer__group">
                    <summary class="menu-drawer__link">
                      {{- link.title | escape -}}
                      {%- render 'icon', icon: 'chevron-down' -%}
                    </summary>
                    <div class="menu-drawer__group-body">
                      {%- if link.type == 'catalog_link' or link.type == 'collection_link' or link.type == 'collections_link' -%}
                        <a href="{{ link.url }}" class="menu-drawer__sublink menu-drawer__sublink--all">
                          {{- 'general.menu.shop_all' | t -}}
                        </a>
                      {%- endif -%}
                      {%- for child in link.links -%}
                        {%- if child.links != blank -%}
                          <details class="menu-drawer__subgroup">
                            <summary class="menu-drawer__sublink menu-drawer__sublink--heading">
                              {{- child.title | escape -}}
                              {%- render 'icon', icon: 'chevron-down' -%}
                            </summary>
                            <ul class="menu-drawer__grandlist" role="list">
                              {%- for grandchild in child.links -%}
                                <li><a href="{{ grandchild.url }}"{% if grandchild.current %} aria-current="page"{% endif %}>{{ grandchild.title | escape }}</a></li>
                              {%- endfor -%}
                            </ul>
                          </details>
                        {%- else -%}
                          <a href="{{ child.url }}" class="menu-drawer__sublink"{% if child.current %} aria-current="page"{% endif %}>
                            {{- child.title | escape -}}
                          </a>
                        {%- endif -%}
                      {%- endfor -%}
                    </div>
                  </details>
                {%- else -%}
                  <a href="{{ link.url }}" class="menu-drawer__link"{% if link.current %} aria-current="page"{% endif %}>
                    {{- link.title | escape -}}
                  </a>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        </nav>

        <div class="menu-drawer__footer">
          {%- if shop.customer_accounts_enabled -%}
            <a href="{{ routes.account_url }}" class="menu-drawer__utility">
              {%- render 'icon', icon: 'account' -%}
              {%- if customer -%}{{ 'customer.account.title' | t }}{%- else -%}{{ 'customer.log_in' | t }}{%- endif -%}
            </a>
          {%- endif -%}
          {%- if settings.whatsapp_number != blank -%}
            {%- assign wa_number = settings.whatsapp_number | remove: '+' | remove: ' ' -%}
            <a href="https://wa.me/{{ wa_number }}?text={{ settings.whatsapp_message | url_encode }}" class="menu-drawer__utility" target="_blank" rel="noopener">
              {%- render 'icon', icon: 'whatsapp' -%}
              {{- 'general.whatsapp' | t -}}
            </a>
          {%- endif -%}
          {% render 'social-icons' %}
        </div>
      </div>
    </details>

    {%- comment -%} Logo {%- endcomment -%}
    {%- if request.page_type == 'index' -%}<h1 class="header__heading">{%- endif -%}
    <a href="{{ routes.root_url }}" class="header__logo">
      {%- if settings.logo != blank -%}
        {{
          settings.logo
          | image_url: width: 600
          | image_tag:
            class: 'header__logo-image',
            widths: '150, 225, 300, 450, 600',
            sizes: '(min-width: 750px) var(--logo-width), 60vw',
            height: logo_height,
            width: settings.logo_width,
            alt: shop.name,
            loading: 'eager'
        }}
      {%- else -%}
        <span class="header__logo-text">{{ shop.name }}</span>
      {%- endif -%}
    </a>
    {%- if request.page_type == 'index' -%}</h1>{%- endif -%}

    {%- comment -%} Desktop navigation {%- endcomment -%}
    <nav class="header__nav" aria-label="{{ 'general.menu.label' | t }}">
      <ul class="header__menu" role="list">
        {%- assign promo_shown = false -%}
        {%- for link in menu.links -%}
          {%- liquid
            assign has_grandchildren = false
            for child in link.links
              if child.links != blank
                assign has_grandchildren = true
                break
              endif
            endfor
          -%}
          <li class="header__menu-item{% if has_grandchildren %} header__menu-item--mega{% endif %}">
            {%- if link.links != blank -%}
              <details class="header__dropdown" data-dropdown>
                <summary class="header__menu-link{% if link.active or link.child_active %} is-active{% endif %}">
                  <span>{{ link.title | escape }}</span>
                  {%- render 'icon', icon: 'chevron-down' -%}
                </summary>

                {%- if has_grandchildren -%}
                  <div class="header__mega scheme-{{ scheme }}">
                    <div class="container header__mega-inner">
                      <div class="header__mega-columns">
                        {%- for child in link.links -%}
                          <div class="header__mega-column{% if child.links.size > 6 %} header__mega-column--wide{% endif %}">
                            <a href="{{ child.url }}" class="header__mega-heading"{% if child.current %} aria-current="page"{% endif %}>
                              {{- child.title | escape -}}
                            </a>
                            {%- if child.links != blank -%}
                              <ul class="header__mega-list{% if child.links.size > 6 %} header__mega-list--split{% endif %}" role="list">
                                {%- for grandchild in child.links -%}
                                  <li>
                                    <a href="{{ grandchild.url }}"{% if grandchild.current %} aria-current="page"{% endif %}>
                                      {{- grandchild.title | escape -}}
                                    </a>
                                  </li>
                                {%- endfor -%}
                              </ul>
                            {%- endif -%}
                          </div>
                        {%- endfor -%}
                        {%- if link.type == 'catalog_link' or link.type == 'collection_link' or link.type == 'collections_link' -%}
                          <a href="{{ link.url }}" class="header__mega-all link-arrow">
                            {{- 'general.menu.shop_all' | t -}}
                            {%- render 'icon', icon: 'arrow-right' -%}
                          </a>
                        {%- endif -%}
                      </div>

                      {%- if promo != blank and promo_shown == false -%}
                        {%- assign promo_shown = true -%}
                        <a href="{{ promo.url }}" class="header__promo">
                          <span class="header__promo-media media" style="--ratio: 1.3;">
                            {%- if promo.featured_image -%}
                              {{
                                promo.featured_image
                                | image_url: width: 640
                                | image_tag: loading: 'lazy', widths: '320, 480, 640', sizes: '300px', alt: ''
                              }}
                            {%- endif -%}
                          </span>
                          <span class="header__promo-text">
                            {%- if section.settings.promo_heading != blank -%}
                              <span class="header__promo-heading">{{ section.settings.promo_heading | escape }}</span>
                            {%- endif -%}
                            {%- if section.settings.promo_text != blank -%}
                              <span class="header__promo-body">{{ section.settings.promo_text | escape }}</span>
                            {%- endif -%}
                            <span class="link-arrow">
                              {{- section.settings.promo_link_label | default: promo.title | escape -}}
                              {%- render 'icon', icon: 'arrow-right' -%}
                            </span>
                          </span>
                        </a>
                      {%- endif -%}
                    </div>
                  </div>
                {%- else -%}
                  <div class="header__submenu scheme-{{ scheme }}">
                    <ul class="header__submenu-list" role="list">
                      {%- for child in link.links -%}
                        <li>
                          <a href="{{ child.url }}" class="header__submenu-link"{% if child.current %} aria-current="page"{% endif %}>
                            {{- child.title | escape -}}
                          </a>
                        </li>
                      {%- endfor -%}
                    </ul>
                  </div>
                {%- endif -%}
              </details>
            {%- else -%}
              <a href="{{ link.url }}" class="header__menu-link{% if link.active %} is-active{% endif %}"{% if link.current %} aria-current="page"{% endif %}>
                <span>{{ link.title | escape }}</span>
              </a>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </nav>

    {%- comment -%} Icons {%- endcomment -%}
    <div class="header__icons">
      <details class="header__search" data-search-toggle>
        <summary class="header__icon" aria-label="{{ 'general.search.label' | t }}">
          {%- render 'icon', icon: 'search' -%}
        </summary>
        <div class="header__search-panel scheme-{{ scheme }}">
          <div class="container header__search-inner">
            {% render 'search-form', id: 'Header' %}
          </div>
        </div>
      </details>

      {%- if shop.customer_accounts_enabled -%}
        <a href="{{ routes.account_url }}" class="header__icon header__icon--account">
          {%- render 'icon', icon: 'account' -%}
          <span class="visually-hidden">
            {%- if customer -%}{{ 'customer.account.title' | t }}{%- else -%}{{ 'customer.log_in' | t }}{%- endif -%}
          </span>
        </a>
      {%- endif -%}

      <a href="{{ routes.cart_url }}" class="header__icon header__icon--cart" data-cart-toggle>
        {%- render 'icon', icon: 'bag' -%}
        {% render 'cart-count-bubble' %}
      </a>
    </div>
  </header>
</div>

{% schema %}
{
  "name": "Header",
  "class": "section-site-header",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu",
      "info": "Nested links become dropdowns. Give a menu item a third level (e.g. Shop plants → By genus → Venus flytraps) to turn it into a full-width mega menu."
    },
    {
      "type": "checkbox",
      "id": "sticky",
      "label": "Sticky header",
      "default": true
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour scheme",
      "options": [
        { "value": "light", "label": "Light" },
        { "value": "surface", "label": "Light surface" },
        { "value": "dark", "label": "Dark" },
        { "value": "accent", "label": "Accent" }
      ],
      "default": "light"
    },
    {
      "type": "header",
      "content": "Mega menu promo"
    },
    {
      "type": "paragraph",
      "content": "Shown in the first mega menu. Uses the collection's image (or its first product's photo)."
    },
    {
      "type": "collection",
      "id": "promo_collection",
      "label": "Collection"
    },
    {
      "type": "text",
      "id": "promo_heading",
      "label": "Heading",
      "default": "New to carnivores?"
    },
    {
      "type": "text",
      "id": "promo_text",
      "label": "Text",
      "default": "Forgiving plants that thrive on a sunny windowsill."
    },
    {
      "type": "text",
      "id": "promo_link_label",
      "label": "Link label",
      "default": "Start here"
    }
  ]
}
{% endschema %}
