<div class="section scheme-light" style="--pt: 48px; --pb: 80px;">
  <div class="container account">
    <header class="account__header">
      <div>
        <p class="eyebrow">{{ 'customer.account.title' | t }}</p>
        {%- assign greeting_name = customer.first_name | default: customer.email -%}
        <h1 class="h2">{{ 'customer.account.greeting' | t: name: greeting_name }}</h1>
      </div>
      <a href="{{ routes.account_logout_url }}" class="btn btn--secondary btn--small">{{ 'customer.log_out' | t }}</a>
    </header>

    <div class="account__grid">
      <section class="account__orders">
        <h2 class="h3">{{ 'customer.orders.title' | t }}</h2>
        {%- paginate customer.orders by 20 -%}
          {%- if customer.orders.size > 0 -%}
            <div class="table-wrap">
              <table class="table">
                <thead>
                  <tr>
                    <th scope="col">{{ 'customer.orders.order_number' | t }}</th>
                    <th scope="col">{{ 'customer.orders.date' | t }}</th>
                    <th scope="col">{{ 'customer.orders.payment_status' | t }}</th>
                    <th scope="col">{{ 'customer.orders.fulfillment_status' | t }}</th>
                    <th scope="col">{{ 'customer.orders.total' | t }}</th>
                  </tr>
                </thead>
                <tbody>
                  {%- for order in customer.orders -%}
                    <tr>
                      <td><a href="{{ order.customer_url }}">{{ order.name }}</a></td>
                      <td>{{ order.created_at | date: format: 'date' }}</td>
                      <td>{{ order.financial_status_label }}</td>
                      <td>{{ order.fulfillment_status_label }}</td>
                      <td>{{ order.total_net_amount | money_with_currency }}</td>
                    </tr>
                  {%- endfor -%}
                </tbody>
              </table>
            </div>
            {% render 'pagination', paginate: paginate %}
          {%- else -%}
            <p>{{ 'customer.orders.none' | t }}</p>
            <a href="{{ routes.all_products_collection_url }}" class="btn btn--primary">{{ 'cart.general.continue' | t }}</a>
          {%- endif -%}
        {%- endpaginate -%}
      </section>

      <aside class="account__details">
        <h2 class="h3">{{ 'customer.account.details' | t }}</h2>
        {%- if customer.default_address -%}
          <address>{{ customer.default_address | format_address }}</address>
        {%- else -%}
          <p>{{ 'customer.addresses.none' | t }}</p>
        {%- endif -%}
        <a href="{{ routes.account_addresses_url }}" class="link-arrow">
          {{- 'customer.addresses.view' | t: count: customer.addresses_count -}}
          {%- render 'icon', icon: 'arrow-right' -%}
        </a>
      </aside>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Customer account",
  "class": "section-main-account",
  "settings": []
}
{% endschema %}
