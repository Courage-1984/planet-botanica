{%- paginate blog.articles by 9 -%}
  <div
    class="section scheme-{{ section.settings.color_scheme }}"
    style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;"
  >
    <div class="container">
      <header class="page-header">
        <div class="page-header__text">
          <h1 class="h1">{{ blog.title | escape }}</h1>
          {%- if section.settings.intro != blank -%}
            <div class="rte page-header__description">{{ section.settings.intro }}</div>
          {%- endif -%}
        </div>
      </header>

      {%- if blog.all_tags.size > 0 and section.settings.show_tags -%}
        <ul class="tag-list" role="list">
          <li><a href="{{ blog.url }}" class="chip{% if current_tags == blank %} is-active{% endif %}">{{ 'blogs.general.all' | t }}</a></li>
          {%- for tag in blog.all_tags -%}
            <li>
              <a href="{{ blog.url }}/tagged/{{ tag | handle }}" class="chip{% if current_tags contains tag %} is-active{% endif %}">{{ tag }}</a>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      <ul class="grid" role="list" style="--cols: 3;">
        {%- for article in blog.articles -%}
          <li>{% render 'article-card', article: article, show_excerpt: true, heading_level: 'h2' %}</li>
        {%- endfor -%}
      </ul>

      {% render 'pagination', paginate: paginate %}
    </div>
  </div>
{%- endpaginate -%}

{% schema %}
{
  "name": "Blog posts",
  "tag": "section",
  "class": "section-main-blog",
  "settings": [
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro text",
      "default": "<p>Growing guides for every genus we sell — watering, light, feeding and dormancy, written for South African conditions.</p>"
    },
    {
      "type": "checkbox",
      "id": "show_tags",
      "label": "Show tag filter",
      "info": "Tag articles by genus (Dionaea, Drosera…) to let readers filter.",
      "default": true
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour scheme",
      "options": [
        { "value": "light", "label": "Light" },
        { "value": "surface", "label": "Light surface" },
        { "value": "dark", "label": "Dark" },
        { "value": "accent", "label": "Accent" }
      ],
      "default": "light"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 64
    }
  ]
}
{% endschema %}
