{%- comment -%}
  Renders a line icon.
  Usage: {% render 'icon', icon: 'search' %}
  Accepts: icon (string), class (optional string)
{%- endcomment -%}

{%- capture paths -%}
  {%- case icon -%}
    {%- when 'search' -%}
      <circle cx="11" cy="11" r="7"/><path d="m21 21-4.35-4.35"/>
    {%- when 'account' -%}
      <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
    {%- when 'bag' -%}
      <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/>
    {%- when 'menu' -%}
      <path d="M3 6h18M3 12h18M3 18h18"/>
    {%- when 'close' -%}
      <path d="M18 6 6 18M6 6l12 12"/>
    {%- when 'chevron-down' -%}
      <path d="m6 9 6 6 6-6"/>
    {%- when 'chevron-left' -%}
      <path d="m15 18-6-6 6-6"/>
    {%- when 'chevron-right' -%}
      <path d="m9 18 6-6-6-6"/>
    {%- when 'arrow-right' -%}
      <path d="M5 12h14M12 5l7 7-7 7"/>
    {%- when 'plus' -%}
      <path d="M12 5v14M5 12h14"/>
    {%- when 'minus' -%}
      <path d="M5 12h14"/>
    {%- when 'check' -%}
      <path d="M20 6 9 17l-5-5"/>
    {%- when 'filter' -%}
      <path d="M4 6h10M18 6h2M4 12h4M12 12h8M4 18h12M20 18h0"/><circle cx="16" cy="6" r="2"/><circle cx="10" cy="12" r="2"/><circle cx="18" cy="18" r="2"/>
    {%- when 'sun' -%}
      <circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>
    {%- when 'water' -%}
      <path d="M12 2.7 17.7 8.3a8 8 0 1 1-11.4 0z"/>
    {%- when 'thermometer' -%}
      <path d="M14 14.76V3.5a2.5 2.5 0 0 0-5 0v11.26a4.5 4.5 0 1 0 5 0z"/>
    {%- when 'moon' -%}
      <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
    {%- when 'humidity' -%}
      <path d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z"/>
    {%- when 'soil' -%}
      <path d="M5 10h14l-1.5 10.1a1 1 0 0 1-1 .9h-9a1 1 0 0 1-1-.9z"/><path d="M4 10h16"/><path d="M12 10V6"/><path d="M12 6c0-2 2-3 4-3 0 2-2 3-4 3z"/><path d="M12 7c0-2-2-3-4-3 0 2 2 3 4 3z"/>
    {%- when 'trap' -%}
      <path d="M3 12c2.5-5 15.5-5 18 0"/><path d="M3 12c2.5 5 15.5 5 18 0"/><path d="m7 8.4-.6-2.2M10.2 7.5 10 5.2M13.8 7.5l.2-2.3M17 8.4l.6-2.2M7 15.6l-.6 2.2M10.2 16.5 10 18.8M13.8 16.5l.2 2.3M17 15.6l.6 2.2"/>
    {%- when 'leaf' -%}
      <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.5 19 2c1 2 2 4.2 2 8 0 5.5-4.8 10-10 10z"/><path d="M2 21c0-3 1.9-5.4 5.1-6C9.5 14.5 12 13 13 12"/>
    {%- when 'ruler' -%}
      <path d="M21.3 15.3 8.7 2.7a1 1 0 0 0-1.4 0L2.7 7.3a1 1 0 0 0 0 1.4l12.6 12.6a1 1 0 0 0 1.4 0l4.6-4.6a1 1 0 0 0 0-1.4z"/><path d="m7.5 10.5 2-2M10.5 13.5l2-2M13.5 16.5l2-2"/>
    {%- when 'globe' -%}
      <circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
    {%- when 'truck' -%}
      <rect x="1" y="4" width="15" height="12" rx="1"/><path d="M16 8h4l3 3v5h-7z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/>
    {%- when 'calendar' -%}
      <rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/>
    {%- when 'clock' -%}
      <circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/>
    {%- when 'info' -%}
      <circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/>
    {%- when 'shield' -%}
      <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/>
    {%- when 'chat' -%}
      <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
    {%- when 'map-pin' -%}
      <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>
    {%- when 'mail' -%}
      <rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 6-10 7L2 6"/>
    {%- when 'phone' -%}
      <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/>
    {%- when 'instagram' -%}
      <rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><path d="M17.5 6.5h.01"/>
    {%- when 'facebook' -%}
      <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
    {%- when 'tiktok' -%}
      <path d="M16 3c.3 2.4 1.9 4 4 4.2v3.2a7 7 0 0 1-4-1.3v6.4A5.5 5.5 0 1 1 10.5 10v3.3a2.3 2.3 0 1 0 2.2 2.3V3z"/>
    {%- when 'youtube' -%}
      <path d="M22.5 6.4a2.8 2.8 0 0 0-2-2C18.8 4 12 4 12 4s-6.8 0-8.5.5a2.8 2.8 0 0 0-2 2A29 29 0 0 0 1 12a29 29 0 0 0 .5 5.6 2.8 2.8 0 0 0 2 2c1.7.4 8.5.4 8.5.4s6.8 0 8.5-.5a2.8 2.8 0 0 0 2-2A29 29 0 0 0 23 12a29 29 0 0 0-.5-5.6z"/><path d="m9.8 15.5 5.7-3.5-5.7-3.5z"/>
    {%- when 'pinterest' -%}
      <circle cx="12" cy="12" r="10"/><path d="M9.5 21 12 11.5M10.4 14.5c.5.9 1.4 1.4 2.5 1.4 2.3 0 3.9-2.1 3.9-4.9 0-2.6-2.2-4.5-5-4.5-3.3 0-5.1 2.3-5.1 4.6 0 1.1.4 2.2 1.2 2.6"/>
    {%- when 'whatsapp' -%}
      <path d="M3 21l1.6-4.6A9 9 0 1 1 7.6 19.4z"/><path d="M9 8.7c0 3.4 2.9 6.3 6.3 6.3l1.2-1.4-2-1-1 .9a5 5 0 0 1-2.9-2.9l.9-1-1-2z"/>
  {%- endcase -%}
{%- endcapture -%}

<svg
  class="icon icon--{{ icon }}{% if class %} {{ class }}{% endif %}"
  aria-hidden="true"
  focusable="false"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  {{- paths -}}
</svg>
