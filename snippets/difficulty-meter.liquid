{%- comment -%}
  Three-dot difficulty meter from the custom.difficulty metafield (1–5).
  1–2 → Easy, 3 → Intermediate, 4–5 → Expert (matches the store's "Level:" tags).
  Accepts: difficulty (Number 1–5)
{%- endcomment -%}

{%- liquid
  assign score = difficulty | plus: 0
  if score <= 2
    assign level = 1
    assign label = 'products.difficulty.easy' | t
  elsif score == 3
    assign level = 2
    assign label = 'products.difficulty.intermediate' | t
  else
    assign level = 3
    assign label = 'products.difficulty.expert' | t
  endif
-%}

<span class="difficulty difficulty--{{ level }}" title="{{ 'products.difficulty.score' | t: score: score }}">
  <span class="difficulty__dots" aria-hidden="true"><i></i><i></i><i></i></span>
  <span class="difficulty__label">{{ label }}</span>
</span>
