{%- comment -%}
  One cart line (drawer and cart page).
  Accepts: item (Object line_item), index (Number, 1-based line)
{%- endcomment -%}

<li class="cart-line" data-line="{{ index }}">
  <a href="{{ item.url }}" class="cart-line__media media" style="--ratio: 1;" tabindex="-1" aria-hidden="true">
    {%- if item.image -%}
      {{ item.image | image_url: width: 240 | image_tag: loading: 'lazy', widths: '120, 240', sizes: '120px', alt: '' }}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
  </a>

  <div class="cart-line__info">
    <a href="{{ item.url }}" class="cart-line__title">{{ item.product.title | escape }}</a>
    {% render 'product-caption', product: item.product, mode: 'latin', class: 'cart-line__botanical' %}

    {%- unless item.product.has_only_default_variant -%}
      <p class="cart-line__meta">
        {%- for option in item.options_with_values -%}
          {{ option.name }}: {{ option.value }}{% unless forloop.last %} · {% endunless %}
        {%- endfor -%}
      </p>
    {%- endunless -%}

    {%- for property in item.properties -%}
      {%- assign first_char = property.first | slice: 0 -%}
      {%- if property.last != blank and first_char != '_' -%}
        <p class="cart-line__meta">{{ property.first }}: {{ property.last }}</p>
      {%- endif -%}
    {%- endfor -%}

    {%- if item.selling_plan_allocation -%}
      <p class="cart-line__meta">{{ item.selling_plan_allocation.selling_plan.name }}</p>
    {%- endif -%}

    {%- for discount in item.line_level_discount_allocations -%}
      <p class="cart-line__discount">{{ discount.discount_application.title }} (−{{ discount.amount | money }})</p>
    {%- endfor -%}

    <div class="cart-line__controls">
      <quantity-input class="qty qty--small">
        <button type="button" name="minus" aria-label="{{ 'cart.line.decrease' | t: product: item.product.title | escape }}">
          {%- render 'icon', icon: 'minus' -%}
        </button>
        <input
          type="number"
          name="updates[]"
          value="{{ item.quantity }}"
          min="0"
          {% if item.variant.inventory_management == 'shopify' and item.variant.inventory_policy == 'deny' %}
            max="{{ item.variant.inventory_quantity }}"
          {% endif %}
          data-line="{{ index }}"
          aria-label="{{ 'cart.line.quantity' | t: product: item.product.title | escape }}"
        >
        <button type="button" name="plus" aria-label="{{ 'cart.line.increase' | t: product: item.product.title | escape }}">
          {%- render 'icon', icon: 'plus' -%}
        </button>
      </quantity-input>
      <button type="button" class="cart-line__remove" data-remove-line="{{ index }}">
        {{- 'cart.line.remove' | t -}}
        <span class="visually-hidden">{{ item.product.title | escape }}</span>
      </button>
    </div>
  </div>

  <div class="cart-line__price">
    {%- if item.original_line_price != item.final_line_price -%}
      <s>{{ item.original_line_price | money }}</s>
    {%- endif -%}
    <span>{{ item.final_line_price | money }}</span>
  </div>
</li>
