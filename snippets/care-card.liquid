{%- comment -%}
  Herbarium-label style care card built from custom.* metafields.
  Accepts: product (Object), heading (String, optional)
{%- endcomment -%}

{%- liquid
  assign plant = product.metafields.custom
  assign latin = plant.latin_name.value
  assign difficulty = plant.difficulty.value
  assign climate = plant.temperature_group.value
  assign dormancy = plant.dormancy_required.value
  assign cites = plant.cites_listed.value
  assign guide = plant.care_guide

  assign card_heading = heading
  if card_heading == blank
    assign card_heading = 'products.care.heading' | t
  endif

  comment
    key:icon pairs — text metafields shown as-is, in this order.
  endcomment
  assign care_keys = 'lux_requirements:sun,water_requirements:water,potting_media:soil,humidity_min:humidity,temp_range:thermometer' | split: ','
  assign specimen_keys = 'origin_location:globe,origin_altitude:ruler,growth_speed:leaf,clonotype_code:info' | split: ','

  assign has_care = false
  for pair in care_keys
    assign key = pair | split: ':' | first
    if plant[key].value != blank
      assign has_care = true
      break
    endif
  endfor
  if climate != blank or dormancy != nil
    assign has_care = true
  endif
-%}

{%- if has_care or latin != blank or difficulty != blank -%}
  <section class="care-card" aria-labelledby="CareCard-{{ product.id }}">
    <header class="care-card__header">
      <p class="eyebrow">{{ card_heading }}</p>
      <h2 id="CareCard-{{ product.id }}" class="care-card__title">
        {%- if latin != blank -%}
          <em>{{ latin }}</em>
        {%- else -%}
          {{ product.title }}
        {%- endif -%}
      </h2>
      <div class="care-card__meta">
        {%- if difficulty != blank -%}
          <span class="care-card__difficulty">
            <span class="care-card__key">{{ 'products.care.difficulty' | t }}</span>
            {% render 'difficulty-meter', difficulty: difficulty %}
          </span>
        {%- endif -%}
        {%- if cites == true -%}
          <span class="badge badge--highlight" title="{{ 'products.care.cites_note' | t }}">{{ 'products.care.cites' | t }}</span>
        {%- endif -%}
      </div>
    </header>

    {%- if has_care -%}
      <dl class="care-card__grid">
        {%- for pair in care_keys -%}
          {%- liquid
            assign parts = pair | split: ':'
            assign key = parts[0]
            assign value = plant[key].value
          -%}
          {%- if value != blank -%}
            <div class="care-card__row">
              <dt>
                {%- render 'icon', icon: parts[1] -%}
                <span class="care-card__key">{% render 'care-label', key: key %}</span>
              </dt>
              <dd>{{ value | newline_to_br }}</dd>
            </div>
          {%- endif -%}
        {%- endfor -%}

        {%- if climate != blank -%}
          <div class="care-card__row">
            <dt>
              {%- render 'icon', icon: 'globe' -%}
              <span class="care-card__key">{% render 'care-label', key: 'temperature_group' %}</span>
            </dt>
            <dd>{% render 'climate-label', climate: climate %}</dd>
          </div>
        {%- endif -%}

        {%- if dormancy != nil -%}
          <div class="care-card__row">
            <dt>
              {%- render 'icon', icon: 'moon' -%}
              <span class="care-card__key">{% render 'care-label', key: 'dormancy_required' %}</span>
            </dt>
            <dd>
              {%- if dormancy -%}
                {{ 'products.care.dormancy_yes' | t }}
              {%- else -%}
                {{ 'products.care.dormancy_no' | t }}
              {%- endif -%}
            </dd>
          </div>
        {%- endif -%}
      </dl>
    {%- endif -%}

    <dl class="care-card__specimen">
      {%- if plant.trap_type.value != blank -%}
        <div class="care-card__row care-card__row--compact">
          <dt>
            {%- render 'icon', icon: 'trap' -%}
            <span class="care-card__key">{% render 'care-label', key: 'trap_type' %}</span>
          </dt>
          <dd>{% render 'trap-label', trap: plant.trap_type.value %}</dd>
        </div>
      {%- endif -%}
      {%- for pair in specimen_keys -%}
        {%- liquid
          assign parts = pair | split: ':'
          assign key = parts[0]
          assign value = plant[key].value
        -%}
        {%- if value != blank -%}
          <div class="care-card__row care-card__row--compact">
            <dt>
              {%- render 'icon', icon: parts[1] -%}
              <span class="care-card__key">{% render 'care-label', key: key %}</span>
            </dt>
            <dd{% if key == 'clonotype_code' %} class="care-card__code"{% endif %}>{{ value }}</dd>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </dl>

    {%- if guide != blank -%}
      <details class="care-card__guide">
        <summary class="link-arrow">
          {{- 'products.care.read_guide' | t -}}
          {%- render 'icon', icon: 'chevron-down' -%}
        </summary>
        <div class="rte care-card__guide-body">{{ guide | metafield_tag }}</div>
      </details>
    {%- endif -%}
  </section>
{%- endif -%}
