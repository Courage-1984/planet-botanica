{%- liquid
  assign networks = 'instagram,facebook,tiktok,youtube,pinterest' | split: ','
-%}

<ul class="social-icons" role="list">
  {%- for network in networks -%}
    {%- assign setting_key = 'social_' | append: network | append: '_link' -%}
    {%- assign link = settings[setting_key] -%}
    {%- if link != blank -%}
      <li>
        <a href="{{ link }}" target="_blank" rel="noopener" class="social-icons__link">
          {%- render 'icon', icon: network -%}
          <span class="visually-hidden">{{ network | capitalize }}</span>
        </a>
      </li>
    {%- endif -%}
  {%- endfor -%}
</ul>
