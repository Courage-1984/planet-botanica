{% layout none %}
{%- assign initial_value = gift_card.initial_value | money -%}

<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex">
    <title>{{ 'gift_cards.issued.title' | t: value: initial_value, shop: shop.name }}</title>
    {% render 'css-variables' %}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>
    {{ content_for_header }}
  </head>

  <body class="template-gift-card scheme-light">
    <main class="gift-card">
      <div class="gift-card__card scheme-dark">
        <p class="eyebrow">{{ shop.name }}</p>
        <h1 class="h2">{{ 'gift_cards.issued.heading' | t: value: initial_value }}</h1>

        {%- if gift_card.enabled == false or gift_card.expired -%}
          <p class="badge badge--muted">{{ 'gift_cards.issued.expired' | t }}</p>
        {%- elsif gift_card.expires_on -%}
          {%- assign expires = gift_card.expires_on | date: format: 'date' -%}
          <p>{{ 'gift_cards.issued.expires_on' | t: date: expires }}</p>
        {%- endif -%}

        {%- if gift_card.balance != gift_card.initial_value -%}
          {%- assign balance = gift_card.balance | money -%}
          <p>{{ 'gift_cards.issued.remaining' | t: balance: balance }}</p>
        {%- endif -%}

        <p class="gift-card__code">{{ gift_card.code | format_code }}</p>
        <div id="QrCode" class="gift-card__qr" data-identifier="{{ gift_card.qr_identifier }}"></div>
      </div>

      <div class="button-row">
        <a href="{{ shop.url }}" class="btn btn--primary">{{ 'gift_cards.issued.shop_link' | t }}</a>
        {%- if gift_card.pass_url -%}
          <a href="{{ gift_card.pass_url }}" class="btn btn--secondary">{{ 'gift_cards.issued.add_to_wallet' | t }}</a>
        {%- endif -%}
        <button type="button" class="btn btn--ghost" onclick="window.print();">{{ 'gift_cards.issued.print' | t }}</button>
      </div>
    </main>

    <script>
      window.addEventListener('load', function () {
        var el = document.getElementById('QrCode');
        if (el && window.QRCode) {
          new QRCode(el, { text: el.dataset.identifier, width: 120, height: 120 });
        }
      });
    </script>
  </body>
</html>
